function openActionModal(){openModal(`<div class="modal-backdrop"><form class="edit-modal" id="customActionForm"><div class="modal-head"><h2>Create governance action</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Action title<input name="title" required placeholder="e.g. Review governance delegations"></label><div class="modal-grid"><label>Practical category<select name="category">${opts(cats,cats[0])}</select></label><label>Whare Tūpuna dimension<select name="dimension">${dimensionOptions('Tāhuhu')}</select></label><label>Timeframe tag<select name="phase">${opts(['Not set','First 90 days','First 6 months','Next 12 months','Custom timeframe'],'Not set')}</select></label><label>Frequency<select name="frequency">${opts(['One-off','Each meeting','Monthly','Quarterly','Six-monthly','Annual'],'One-off')}</select></label></div><label>Description<textarea name="description" rows="3"></textarea></label><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button class="btn" type="submit">Add to workplan</button></div></form></div>`);document.getElementById('customActionForm').onsubmit=e=>{e.preventDefault();let d=new FormData(e.target);let title=String(d.get('title')).trim();if(!title)return;state.actions.push({id:'custom-'+Date.now(),title,description:d.get('description'),category:d.get('category'),dimension:d.get('dimension'),phase:d.get('phase')==='Not set'?'':d.get('phase'),frequency:d.get('frequency'),source:'Board-created action',responsible:'Unallocated',accountable:'Full Board',reviewer:'None',status:'Not added',date:'',notes:''});save();closeModal();render();toast('Action created')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal)}
function openEditAction(id){const a=state.actions.find(x=>x.id===id);if(!a)return;openModal(`<div class="modal-backdrop"><form class="edit-modal" id="editActionForm"><div class="modal-head"><h2>Edit governance action</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Action title<input name="title" required value="${esc(a.title)}"></label><div class="modal-grid"><label>Category<select name="category">${opts(cats,a.category)}</select></label><label>Whare dimension<select name="dimension">${dimensionOptions(a.dimension)}</select></label><label>Timeframe tag<select name="phase">${opts(['','First 90 days','First 6 months','Next 12 months','Custom timeframe'],a.phase||'')}</select></label><label>Frequency<select name="frequency">${opts(['One-off','Each meeting','Monthly','Quarterly','Six-monthly','Annual'],a.frequency)}</select></label></div><label>Description<textarea name="description" rows="3">${esc(a.description||'')}</textarea></label><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button class="btn" type="submit">Save changes</button></div></form></div>`);document.getElementById('editActionForm').onsubmit=e=>{e.preventDefault();let d=new FormData(e.target);for(let f of ['title','category','dimension','phase','frequency','description'])a[f]=d.get(f);save();closeModal();render();toast('Action updated')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal)}
function openStructureModal(id){const n=state.structure.find(x=>x.id===id);if(!n)return;const org=n.kind==='organisations';openModal(`<div class="modal-backdrop"><form class="edit-modal" id="structureForm"><div class="modal-head"><h2>Edit governance structure</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Group / role name<input name="name" required value="${esc(n.name)}"></label><label>Entry type<select name="kind"><option value="people" ${!org?'selected':''}>People / role</option><option value="organisations" ${org?'selected':''}>Organisations / groups</option></select></label><label>${org?'Organisation names':'Members'} (one per line)<textarea name="entries" rows="5">${esc((org?n.entities:n.members).join('\n'))}</textarea></label>${!org?`<div class="edit-member-quick"><p class="meta">Click a person to add or remove them:</p><div class="person-chips">${state.people.map(p=>`<button type="button" class="member-toggle ${n.members.includes(p)?'selected':''}" data-member="${esc(p)}">${esc(p)}</button>`).join('')}</div></div>`:''}<div class="modal-grid"><label>Contact number<input name="phone" type="tel" value="${esc(n.phone||'')}"></label><label>Email address<input name="email" type="email" value="${esc(n.email||'')}"></label></div><label>Postal address<textarea name="postal" rows="2">${esc(n.postal||'')}</textarea></label><label>Other roles held (conflicts of interest)<textarea name="otherRoles" rows="2">${esc(n.otherRoles||'')}</textarea></label><label>Additional notes<textarea name="detail" rows="2">${esc(n.detail||'')}</textarea></label><div class="modal-grid"><fieldset class="role-checkboxes"><legend>Linked allocation roles</legend>${state.roles.map(r=>`<label><input type="checkbox" name="linkedRoles" value="${esc(r)}" ${(n.linkedRoles||[n.role]).includes(r)?'checked':''}> ${esc(r)}</label>`).join('')}</fieldset><label>Parent group (appointed by)<select name="parent">${opts(['',...state.structure.filter(x=>x.id!==id).map(x=>x.id)],n.parent||'')}</select></label></div><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button class="btn" type="submit">Save changes</button></div></form></div>`);document.querySelectorAll('[data-member]').forEach(b=>b.onclick=()=>{let t=document.querySelector('#structureForm [name=entries]');let a=t.value.split('\n').map(x=>x.trim()).filter(Boolean);a=a.includes(b.dataset.member)?a.filter(x=>x!==b.dataset.member):[...a,b.dataset.member];t.value=a.join('\n');b.classList.toggle('selected')});document.getElementById('structureForm').onsubmit=e=>{e.preventDefault();let d=new FormData(e.target);n.name=String(d.get('name')).trim();n.kind=d.get('kind');let entries=[...new Set(String(d.get('entries')).split(/\n|,/).map(x=>x.trim()).filter(Boolean))];if(n.kind==='organisations'){n.entities=entries;n.members=[]}else{n.members=entries;n.entities=[];entries.forEach(p=>{if(!state.people.includes(p))state.people.push(p)})}n.detail=d.get('detail');n.phone=d.get('phone');n.email=d.get('email');n.postal=d.get('postal');n.otherRoles=d.get('otherRoles');n.linkedRoles=d.getAll('linkedRoles');n.role=n.linkedRoles[0]||'';n.parent=d.get('parent');save();closeModal();render();toast('Structure updated')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal)}

function openNewPersonModal(){
 openModal(`<div class="modal-backdrop"><form class="edit-modal" id="newPersonForm"><div class="modal-head"><h2>Add individual</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Full name<input name="name" required></label><div class="modal-grid"><label>Contact number<input name="phone" type="tel"></label><label>Email address<input name="email" type="email"></label></div><label>Postal address<textarea name="postal" rows="2"></textarea></label><label>Position / title<input name="title"></label><label>Other roles held (conflicts of interest)<textarea name="otherRoles" rows="2"></textarea></label><fieldset class="role-checkboxes"><legend>Linked allocation roles</legend>${state.roles.map(r=>`<label><input type="checkbox" name="linkedRoles" value="${esc(r)}"> ${esc(r)}</label>`).join('')}</fieldset><label>Additional notes<textarea name="notes" rows="2"></textarea></label><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button class="btn" type="submit">Create individual</button></div></form></div>`);
 document.getElementById('newPersonForm').onsubmit=e=>{e.preventDefault();let d=new FormData(e.target),name=String(d.get('name')).trim();if(!name||state.people.includes(name)){toast('Name is blank or already exists');return}state.people.push(name);state.profiles[name]={phone:d.get('phone'),email:d.get('email'),postal:d.get('postal'),title:d.get('title'),otherRoles:d.get('otherRoles'),linkedRoles:d.getAll('linkedRoles'),notes:d.get('notes')};save();closeModal();render();toast('Individual created')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal);
}
function openNewGroupModal(){
 openModal(`<div class="modal-backdrop"><form class="edit-modal" id="newGroupForm"><div class="modal-head"><h2>Create committee, group or position</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Group / position title<input name="name" required></label><div class="modal-grid"><label>Entry type<select name="kind"><option value="people">People / role</option><option value="organisations">Organisations / groups</option></select></label><label>Parent group (appointed by)<select name="parent">${state.structure.map(n=>`<option value="${esc(n.id)}">${esc(n.name)}</option>`).join('')}<option value="" selected>No parent group</option></select></label></div><div id="newGroupMembers"><label>Members (select from list below)</label><div class="edit-member-quick"><p class="meta">Select members now, or drag individuals from the directory into this group after creation.</p><div class="person-chips">${state.people.map(p=>`<button type="button" class="member-toggle" data-new-member="${esc(p)}">${esc(p)}</button>`).join('')}</div></div></div><div id="newGroupOrganisations" style="display:none"><label>Organisation names (one per line)<textarea name="entities" rows="3"></textarea></label></div><div class="modal-grid"><label>Contact number<input name="phone" type="tel"></label><label>Email address<input name="email" type="email"></label></div><label>Postal address<textarea name="postal" rows="2"></textarea></label><fieldset class="role-checkboxes"><legend>Linked allocation roles</legend>${state.roles.map(r=>`<label><input type="checkbox" name="linkedRoles" value="${esc(r)}"> ${esc(r)}</label>`).join('')}</fieldset><label>Additional notes<textarea name="detail" rows="2"></textarea></label><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button type="submit" class="btn">Create group / position</button></div></form></div>`);
 const form=document.getElementById('newGroupForm');const selected=new Set();const kind=form.elements.kind;
 function switchKind(){document.getElementById('newGroupMembers').style.display=kind.value==='people'?'':'none';document.getElementById('newGroupOrganisations').style.display=kind.value==='organisations'?'':'none'}
 kind.onchange=switchKind;
 document.querySelectorAll('[data-new-member]').forEach(b=>b.onclick=()=>{let name=b.dataset.newMember;if(selected.has(name))selected.delete(name);else selected.add(name);b.classList.toggle('selected',selected.has(name))});
 form.onsubmit=e=>{e.preventDefault();let d=new FormData(e.target),name=String(d.get('name')).trim();if(!name)return;let id='group-'+Date.now(),entryKind=d.get('kind');let entries=entryKind==='people'?[...selected]:String(d.get('entities')||'').split(/\n|,/).map(x=>x.trim()).filter(Boolean);let roles=d.getAll('linkedRoles');if(!roles.length&&entryKind==='people')roles=[name];roles.forEach(r=>{if(!state.roles.includes(r))state.roles.push(r)});let n={id,name,kind:entryKind,members:entryKind==='people'?entries:[],entities:entryKind==='organisations'?entries:[],parent:d.get('parent'),role:roles[0]||'',linkedRoles:roles,phone:d.get('phone'),email:d.get('email'),postal:d.get('postal'),detail:d.get('detail')};state.structure.push(n);save();closeModal();render();toast('Group / position created — drag more people into it from the directory')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal);
}

function openProfile(name){const p=state.profiles[name]||{};const groups=state.structure.filter(n=>n.members.includes(name)).map(n=>n.name);openModal(`<div class="modal-backdrop"><form class="edit-modal" id="profileForm"><div class="modal-head"><h2>Individual profile</h2><button type="button" class="mini-btn" data-close-modal>✕</button></div><label>Full name<input name="name" required value="${esc(name)}"></label><div class="modal-grid"><label>Email<input type="email" name="email" value="${esc(p.email||'')}"></label><label>Phone<input type="tel" name="phone" value="${esc(p.phone||'')}"></label><label>Position / title<input name="title" value="${esc(p.title||'')}"></label></div><p class="meta"><b>Current groups:</b> ${esc(groups.join(', ')||'None')}</p><label>Postal address<textarea name="postal" rows="2">${esc(p.postal||'')}</textarea></label><label>Other roles held (conflict of interest declarations)<textarea name="otherRoles" rows="2">${esc(p.otherRoles||'')}</textarea></label><fieldset class="role-checkboxes"><legend>Linked allocation roles</legend>${state.roles.map(r=>`<label><input type="checkbox" name="linkedRoles" value="${esc(r)}" ${(p.linkedRoles||[]).includes(r)?'checked':''}> ${esc(r)}</label>`).join('')}</fieldset><label>Additional notes<textarea name="notes" rows="3">${esc(p.notes||'')}</textarea></label><div class="modal-actions"><button type="button" class="btn secondary" data-close-modal>Cancel</button><button class="btn" type="submit">Save profile</button></div></form></div>`);document.getElementById('profileForm').onsubmit=e=>{e.preventDefault();let d=new FormData(e.target);let newName=String(d.get('name')).trim();if(newName!==name){state.people=state.people.map(x=>x===name?newName:x);state.structure.forEach(n=>n.members=n.members.map(x=>x===name?newName:x));state.actions.forEach(a=>['responsible','accountable','reviewer'].forEach(f=>{if(a[f]===name)a[f]=newName}));delete state.profiles[name]}state.profiles[newName]={email:d.get('email'),phone:d.get('phone'),title:d.get('title'),postal:d.get('postal'),otherRoles:d.get('otherRoles'),linkedRoles:d.getAll('linkedRoles'),notes:d.get('notes')};save();closeModal();render();toast('Profile saved')};document.querySelectorAll('[data-close-modal]').forEach(b=>b.onclick=closeModal)}
function render(){nav();document.getElementById('content').innerHTML=({'Overview':overview,'Board Workplan':plan,'Action Library':libraryPage,'Annual Calendar':calendar,'Roles & Responsibilities':rolesPage,'Governance Structure':structurePage,'Aromatawai Progress':progress,'Quarterly Summary':report}[tab])();bind()}
function bind(){document.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>{tab=b.dataset.goto;filter='';catFilter='All';render()});document.querySelectorAll('[data-field]').forEach(el=>el.onchange=()=>{let a=state.actions.find(x=>x.id===el.dataset.id);if(a){a[el.dataset.field]=el.value;save();toast('Action updated')}});document.querySelectorAll('.allocation-trigger').forEach(btn=>btn.onclick=(e)=>{e.stopPropagation();const wrapper=btn.closest('.allocation-dropdown');const wasOpen=wrapper.classList.contains('open');document.querySelectorAll('.allocation-dropdown.open').forEach(d=>{d.classList.remove('open');d.querySelector('.allocation-trigger').setAttribute('aria-expanded','false')});if(!wasOpen){wrapper.classList.add('open');btn.setAttribute('aria-expanded','true')}});
 document.querySelectorAll('.allocation-subtrigger').forEach(btn=>btn.onclick=(e)=>{e.stopPropagation();const parent=btn.closest('.allocation-submenu');const open=parent.classList.toggle('expanded');btn.setAttribute('aria-expanded',String(open))});
 document.querySelectorAll('[data-allocate]').forEach(btn=>btn.onclick=()=>{const action=state.actions.find(a=>a.id===btn.dataset.allocate);if(!action)return;action[btn.dataset.allocateField]=btn.dataset.allocateValue;save();render();toast('Action allocation updated')});
 document.querySelectorAll('[data-edit-action]').forEach(b=>b.onclick=()=>openEditAction(b.dataset.editAction));document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{if(confirm('Remove this action from the workplan?')){state.actions=state.actions.filter(x=>x.id!==b.dataset.remove);save();render()}});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{let x=library.find(y=>y.title===b.dataset.add);if(!x)return;state.actions.push({...x,id:'lib-'+Date.now(),description:'',source:'TWH Governance Action Library',phase:'',responsible:'Unallocated',accountable:'Full Board',reviewer:'None',status:'Not added',date:'',notes:''});save();render();toast('Added to workplan')});let q=document.getElementById('search');if(q)q.oninput=()=>{filter=q.value;let pos=q.selectionStart;render();let nq=document.getElementById('search');nq.focus();nq.setSelectionRange(pos,pos)};let cy=document.getElementById('calYear');if(cy)cy.onchange=()=>{calendarYear=Number(cy.value);render()};let cr=document.getElementById('calRole');if(cr)cr.onchange=()=>{calendarRole=cr.value;render()};let c=document.getElementById('category');if(c)c.onchange=()=>{catFilter=c.value;render()};let n=document.getElementById('newRole');if(n)n.onclick=()=>openNewGroupModal();let add=document.getElementById('addCustom');if(add)add.onclick=()=>openActionModal();document.querySelectorAll('[data-edit-node]').forEach(b=>b.onclick=()=>editStructureNode(b.dataset.editNode));document.querySelectorAll('[data-delete-node]').forEach(b=>b.onclick=()=>{if(!confirm('Remove this group from the chart?'))return;state.structure=state.structure.filter(n=>n.id!==b.dataset.deleteNode);save();render()});let np=document.getElementById('newPerson');if(np)np.onclick=()=>openNewPersonModal();let ns=document.getElementById('newStructureNode');if(ns)ns.onclick=()=>openNewGroupModal();document.querySelectorAll('[data-rename-person]').forEach(b=>b.onclick=()=>{let old=b.dataset.renamePerson;let name=prompt('Rename individual:',old);if(!name||!name.trim()||name.trim()===old)return;name=name.trim();state.people=state.people.map(x=>x===old?name:x);state.structure.forEach(n=>n.members=n.members.map(x=>x===old?name:x));state.actions.forEach(a=>{for(let f of ['responsible','accountable','reviewer'])if(a[f]===old)a[f]=name});if(calendarRole===old)calendarRole=name;save();render()});
 document.querySelectorAll('[data-person]').forEach(b=>{b.onclick=()=>openProfile(b.dataset.person);b.ondragstart=e=>{e.dataTransfer.setData('text/plain',b.dataset.person);e.dataTransfer.effectAllowed='copy'}});
 document.querySelectorAll('[data-drop-node]').forEach(n=>{n.ondragover=e=>{let x=state.structure.find(v=>v.id===n.dataset.dropNode);if(x&&x.kind!=='organisations'){e.preventDefault();n.classList.add('drop-target')}};n.ondragleave=()=>n.classList.remove('drop-target');n.ondrop=e=>{e.preventDefault();n.classList.remove('drop-target');let person=e.dataTransfer.getData('text/plain');let x=state.structure.find(v=>v.id===n.dataset.dropNode);if(x&&x.kind!=='organisations'&&state.people.includes(person)&&!x.members.includes(person)){x.members.push(person);save();render();toast(person+' added to '+x.name)}}});
}

render();
</script></body></html>
