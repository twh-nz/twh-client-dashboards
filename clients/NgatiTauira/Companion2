const recs=[{"id": "rec-1", "title": "Strengthen the Strategic Plan (goals, owners, implementation, sustainability)", "description": "Turn each priority in the Strategic Plan into SMART goals (specific, measurable, achievable, relevant and time-bound), each with a named owner. Then further deepen the plan to connect it to implementation and sustainability beyond existing contracts. The board would then be able to see whether the strategy is progressing.", "phase": "First 90 days", "source": "Ngāti Tauira GA · rec-1"}, {"id": "rec-2", "title": "Fill in an Annual Board Calendar", "description": "Finish the Annual Board Calendar the board has started, so it shows every governance milestone for the year, including a regular check of open actions. The board would plan its work ahead instead of reacting to the next deadline.", "phase": "First 90 days", "source": "Ngāti Tauira GA · rec-2"}, {"id": "rec-3", "title": "Develop a Board Secretary role description and reporting line", "description": "Write a one-page position description for the Board Secretary, decide who the role reports to, and record how the role is filled. The board would know who keeps its minutes, records and filings, and to whom that person answers.", "phase": "First 90 days", "source": "Ngāti Tauira GA · rec-3"}, {"id": "rec-4", "title": "Clarify one Chair role description with delegated authorities", "description": "Bring the Chair's role into one position description, and write down what the Chair and the Manager may decide without the full board. Everyone would know who can decide what on behalf of the board, and urgent decisions between hui would have a clear, agreed process.", "phase": "First 90 days", "source": "Ngāti Tauira GA · rec-4"}, {"id": "rec-5", "title": "Build a KPI framework and a board dashboard", "description": "Agree with the Manager a set of KPIs (key performance indicators) to show whether the strategy is progressing. Then show them as a one-page dashboard. The board and the Manager can then judge performance off the same set of measures, and the board would regularly see the progress on its strategy.", "phase": "First 6 months", "source": "Ngāti Tauira GA · rec-5"}, {"id": "rec-6", "title": "Agree a clear Manager performance review approach", "description": "Replace the current quarterly and annual reviews of the Manager with one annual review, agreed with the Manager and based on the KPIs (measures of performance) from Top Rec 5 . The review would support the Manager's growth as well as hold the Manager to account.", "phase": "First 6 months", "source": "Ngāti Tauira GA · rec-6"}, {"id": "rec-7", "title": "Focus on current and future board succession", "description": "Appoint a deputy Chair, build a board skills matrix (a table of the skills the board has and the skills it needs), and fill the seventh seat with someone who brings the skills that the board lacks. This allows the board to have someone ready to step in if the Chair leaves, and means future trustees would be found and supported before they are needed.", "phase": "First 6 months", "source": "Ngāti Tauira GA · rec-7"}, {"id": "rec-8", "title": "Name board leads for key partnerships", "description": "Name a trustee to lead each major partnership at governance level, with the Manager retaining the relationship at an operational level. This would mean the Trust's key relationships no longer depend on the Manager alone.", "phase": "First 6 months", "source": "Ngāti Tauira GA · rec-8"}, {"id": "rec-9", "title": "Set up a marae representatives' forum", "description": "Set up a forum with one representative from each of the three marae that reports to the board at every hui. Marae and iwi members would have a direct way to bring their voice to the board, and the board's strategy would be shaped by the people the Trust serves.", "phase": "Next 12 months", "source": "Ngāti Tauira GA · rec-9"}, {"id": "rec-10", "title": "Write a policy on trustee and staff whānau links", "description": "Add to the Board Charter how the board manages whānau links between trustees and staff, and add a tikanga-based way to settle disputes to the Trust Deed. The board would have an agreed process to follow when an issue or dispute is raised.", "phase": "First 6 months", "source": "Ngāti Tauira GA · rec-10"}],library=[{"title": "Review organisational risk register", "category": "Risk Management", "frequency": "Quarterly", "dimension": "Pou Tuarongo"}, {"title": "Review compliance obligations and reporting deadlines", "category": "Legal & Regulatory Compliance", "frequency": "Quarterly", "dimension": "Tūāpapa"}, {"title": "Approve annual budget", "category": "Finance & Audit", "frequency": "Annual", "dimension": "Maihi"}, {"title": "Review conflicts of interest register", "category": "Legal & Regulatory Compliance", "frequency": "Each meeting", "dimension": "Tūāpapa"}, {"title": "Review Board Charter and policies", "category": "Policies & Governance Documents", "frequency": "Annual", "dimension": "Tūāpapa"}, {"title": "Evaluate board effectiveness", "category": "Board Development & Succession", "frequency": "Annual", "dimension": "Tekoteko"}, {"title": "Review CEO performance", "category": "Leadership & CEO Oversight", "frequency": "Annual", "dimension": "Tekoteko"}, {"title": "Review strategic KPIs", "category": "Performance & Accountability", "frequency": "Quarterly", "dimension": "Maihi"}, {"title": "Review stakeholder engagement plan", "category": "Relationships & Engagement", "frequency": "Annual", "dimension": "Mahau"}, {"title": "Review tikanga and kaupapa alignment", "category": "Tikanga, Culture & Kaupapa", "frequency": "Annual", "dimension": "Tūāpapa"}, {"title": "Confirm meeting agenda and proposed resolutions", "category": "Board Meetings & Decision-making", "frequency": "Each meeting", "dimension": "Pou Tokomanawa"}, {"title": "Review strategic plan and annual priorities", "category": "Strategy & Planning", "frequency": "Annual", "dimension": "Tāhuhu"}, {"title": "Review trustee skills and diversity matrix", "category": "Board Development & Succession", "frequency": "Annual", "dimension": "Tekoteko"}, {"title": "Review financial controls and delegations", "category": "Finance & Audit", "frequency": "Annual", "dimension": "Maihi"}, {"title": "Prepare board packs and circulate papers", "category": "Board Meetings & Decision-making", "frequency": "Each meeting", "dimension": "Pou Tūhono"}, {"title": "Review committee Terms of Reference", "category": "Policies & Governance Documents", "frequency": "Annual", "dimension": "Pou Tūhono"}, {"title": "Review succession and trustee induction", "category": "Board Development & Succession", "frequency": "Annual", "dimension": "Tekoteko"}, {"title": "Review health and safety oversight", "category": "Risk Management", "frequency": "Quarterly", "dimension": "Pou Tuarongo"}];
